{
  "name": "knowledge-base-website",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run build && bun run preview:edge",
    "build": "bun run gen-content && vite build && bun run scripts/generate-route-files.ts",
    "gen-content": "bun run scripts/build-content.ts",
    "test": "bun test",
    "preview": "bun run preview:edge",
    "preview:edge": "bun run scripts/preview-edge.ts",
    "type-check": "tsc --noEmit",
    "verify": "bun run scripts/verify-site.ts",
    "verify:strict": "REQUIRE_CLEAN_LINKS=true bun run scripts/verify-site.ts"
  },
  "dependencies": {
    "@telnyx-private/bootstrap": "file:vendor/telnyx-private-bootstrap-0.0.1.tgz",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "wouter": "^2.12.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^25.0.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.3",
    "happy-dom": "^20.14.5",
    "parse5": "^8.0.1",
    "typescript": "5.2.2",
    "vite": "^7.1.7"
  }
}
